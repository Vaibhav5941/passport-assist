{
  "name": "passport-assist",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx database/migrate.ts",
    "db:seed": "tsx database/seed.ts",
    "setup": "node scripts/init-env.mjs && npm run db:migrate && npm run db:seed",
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch backend/src/server.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -p backend/tsconfig.json && tsc -p frontend/tsconfig.json",
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts",
    "start": "tsx backend/src/server.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
