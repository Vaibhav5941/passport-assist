# Copy to .env (npm run setup does this and generates random secrets)
DATABASE_URL="postgresql://passport:passport_local_only@localhost:5433/passport"
TEST_DATABASE_URL="postgresql://passport:passport_local_only@localhost:5433/passport_test"
# Minimum 32 characters each
STATE_SIGNING_SECRET=
MOCK_PROVIDER_SECRET=
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Enables the simulated provider page and the outage switch
DEMO_MODE=true
